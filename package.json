{
  "name": "@t3n/eslint-configs",
  "version": "6.2.1",
  "description": "ESLint configs for t3n JS projects",
  "type": "module",
  "scripts": {
    "eslint:inspect": "eslint --inspect-config",
    "prettier:check": "lerna run prettier:check --parallel",
    "lint": "eslint ./test/** && lerna run lint --parallel",
    "upgrade-interactive": "npm-check-updates --interactive && npm-check-updates --interactive --packageFile packages/base/package.json && npm-check-updates --interactive --packageFile packages/react/package.json && npm-check-updates --interactive --packageFile packages/typescript/package.json "
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/t3n/eslint-config.git"
  },
  "main": "index.js",
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.2.2",
    "@eslint/compat": "^1.4.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/react": "^18.3.26",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "lerna": "^9.0.0",
    "npm-check-updates": "^19.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "react": "^18.3.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
